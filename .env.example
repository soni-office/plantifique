# ============================================================
# Environment variable reference — copy to .env.dev or .env.prod
# and fill in real values. See .env.dev for dev defaults.
# ============================================================

# ---- General ----
ENV=dev                          # 'dev' | 'prod'
GCP_PROJECT=tiktok-ai-agent-488417
FIRESTORE_DATABASE=              # Optional: overrides auto-derived plantifique-pop-{ENV}

# ---- Organisation ----
# The Firestore document ID in the 'orgs' collection for this deployment.
# Used as the shared key for all users and tokens. Do NOT change after first deploy.
ORG_ID=org_plantifique

# ---- TikTok OAuth ----
APP_KEY=
APP_SECRET=
REDIRECT_URI=http://localhost:8000/auth/tiktokshop/callback
AUTH_URL=https://auth.tiktok-shops.com/oauth/authorize
TOKEN_URL=https://auth.tiktok-shops.com/api/v2/token/get

# ---- Frontend / CORS ----
FRONTEND_URL=http://localhost:5173
FRONTEND_OAUTH_CALLBACK_PATH=/auth/tiktokshop/callback
EXTRA_CORS_ORIGINS=              # Comma-separated extra CORS origins (e.g. *.firebaseapp.com)

# ---- JWT ----
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXP_MINUTES=60

# ---- LLM ----
# minmax_api_key=
# MINIMAX_BASE_URL=https://api.minimax.chat/v1

# ---- Token Encryption ----
TIKTOK_TOKEN_ENCRYPTION_KEY=     # Generate with: python fernet_key_creation.py

# ---- Google Cloud Identity Platform (GCIP) / Firebase ----
# Tenant ID: found in GCP Console → Identity Platform → Tenants
FIREBASE_TENANT_ID=teampop-6fiht
# Web API Key: found in Firebase Console → Project Settings → General → Web API Key
# Used to send invite emails via the Identity Toolkit REST API.
FIREBASE_WEB_API_KEY=

# ---- RAG ----
WANT_TO_USE_RAG=false

# ---- Automation Scheduler ----
# Secret shared between GCP Cloud Scheduler and the /internal/* endpoints.
INTERNAL_API_SECRET=

# ---- Redis / Cache ----
# Local dev : redis://localhost:6379
# Upstash   : rediss://:password@host.upstash.io:6380  (TLS — note rediss://)
REDIS_URL=redis://localhost:6379

# Per-domain TTLs (seconds). Override any of these to tune without redeploying.
CACHE_TTL_SHOP_CIPHER=3600       # TikTok shop cipher — rotates with access token (1 h)
CACHE_TTL_CREATOR_SEARCH=300     # Marketplace creator search results (5 min)
CACHE_TTL_CREATOR_DETAIL=900     # Individual creator profile (15 min)
CACHE_TTL_PRODUCT_SEARCH=600     # Product search results (10 min)
CACHE_TTL_PRODUCT_DETAIL=900     # Individual product detail (15 min)
CACHE_TTL_SHOP_PRODUCTS=600      # Shaped shop product list for picker UI (10 min)
CACHE_TTL_TIER_CONFIG=300        # Tier creator/product/tier5 config (5 min)
CACHE_TTL_SAMPLE_LIST=300        # Paginated sample request list (5 min; sync invalidates early)
CACHE_TTL_SAMPLE_ITEM=600        # Per-sample review/analysis state (10 min; updates invalidate early)
